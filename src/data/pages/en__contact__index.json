          "blocks": [
            {
              "t": "heading",
              "level": 2,
              "html": "Other ways to reach us"
            },
            {
              "t": "p",
              "html": "For penetration testing, do not send technical system details or login details through any of these channels. We write the scope together first."
            },
            {
              "t": "heading",
              "level": 2,
              "html": "What happens next"
            },
            {
              "t": "p",
              "html": "We reply within one working day."
            },
            {
              "t": "list",
              "ordered": true,
              "items": [
                "We read your message.",
                "We set a time for a scoping conversation.",
                "We send a written proposal with the scope, deliverables and a fixed price."
              ]
            }
          ]
        }
