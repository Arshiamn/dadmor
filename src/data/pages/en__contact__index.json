        {
         "t": "p",
         "html": "This form isn't connected here, but your text is still sitting in it. Copy it and send it by email or WhatsApp instead."
        },
        {
         "t": "p",
         "html": "Email: <a href=\"mailto:hello@dadmor.com\" dir=\"ltr\">hello@dadmor.com</a> · WhatsApp: <a href=\"https://wa.me/989391400826\" rel=\"noopener\" dir=\"ltr\">+98 939 140 0826</a>"
        },
        {
         "t": "raw",
         "html": "<button type=\"button\" class=\"btn btn-ghost btn-small\" data-copy-form=\"None\">Copy text</button>",
         "class": "btn btn-ghost btn-small",
         "tag": "button"
        }
       ]
      },
      {
       "t": "raw",
       "html": "<form name=\"contact\" method=\"POST\" action=\"/contact/\" data-netlify=\"true\" netlify-honeypot=\"bot-field\" data-contact-form=\"None\" data-error-service=\"Choose a service, or \" not=\"None\" sure=\"None\" yet\".\"=\"None\" data-copy-label=\"Copy text\" novalidate=\"None\"> <input type=\"hidden\" name=\"form-name\" value=\"contact\"> <p hidden=\"None\" aria-hidden=\"true\"><label>Bots only: <input name=\"bot-field\" tabindex=\"-1\" autocomplete=\"off\"></label></p> <div class=\"form-errors\" data-form-summary=\"None\" role=\"alert\" hidden=\"None\"><p>Please fix the following bits:</p><ul></ul></div> <div class=\"field\"> <label for=\"cf-name\">Your name (required)</label> <input id=\"cf-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required=\"None\" data-error-name=\"Please tell us your name.\"> <p class=\"field-error\" data-error-for=\"name\" hidden=\"None\"></p> </div> <div class=\"field\"> <label for=\"cf-email\">Your email (required)</label> <input id=\"cf-email\" name=\"email\" type=\"email\" dir=\"ltr\" autocomplete=\"email\" required=\"None\" data-error-email=\"That email doesn't look right. Try something like name@example.com\"> <p class=\"field-hint\">This is where our reply will go.</p> <p class=\"field-error\" data-error-for=\"email\" hidden=\"None\"></p> </div> <div class=\"field\"> <label for=\"cf-service\">Which service? (required)</label> <select id=\"cf-service\" name=\"service\" required=\"None\"> <option value=\"\"> </option> <option value=\"Website building\">Website building</option><option value=\"UI/UX design\">UI/UX design</option><option value=\"Business model design\">Business model design</option><option value=\"Documentation\">Documentation</option><option value=\"Penetration testing\">Penetration testing</option><option value=\"Marketing and content\">Marketing and content</option><option value=\"Not sure yet\">Not sure yet</option> </select> <p class=\"field-error\" data-error-for=\"service\" hidden=\"None\"></p> </div> <div class=\"field\"> <label for=\"cf-message\">Your message (required)</label> <textarea id=\"cf-message\" name=\"message\" rows=\"6\" required=\"None\" data-error-message=\"Please write a few lines about what you need.\"></textarea> <p class=\"field-hint\">What you need, who it's for, and when you need it by. Please don't put passwords or login details in here.</p> <p class=\"field-error\" data-error-for=\"message\" hidden=\"None\"></p> </div> <fieldset class=\"field\"> <legend>How would you like us to reply? (optional)</legend> <label class=\"radio\"><input type=\"radio\" name=\"channel\" value=\"Email\"> <span>Email</span></label> <label class=\"radio\"><input type=\"radio\" name=\"channel\" value=\"WhatsApp\"> <span>WhatsApp</span></label> <label class=\"radio\"><input type=\"radio\" name=\"channel\" value=\"Telegram\"> <span>Telegram</span></label> </fieldset> <button class=\"btn btn-primary\" type=\"submit\" data-submit=\"None\">Send it to us</button> <p class=\"field-hint\"><a href=\"/en/privacy/\">Only these fields are sent, and we only use them to reply to you. The privacy page has the details.</a></p> </form>",
       "class": "",
       "tag": "form"
      },
